# Copy this file to .env and replace the placeholders. Keep .env private.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=movie_night_db

# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret_key

# 1 = development only; use 0 in production
FLASK_DEBUG=1
