# Template for .env - copy to .env (copy .env.example .env) and fill in real values.
# .env.example is safe to share; .env is secret and is ignored by Git.

# --- MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=trip_planner_db

# --- Flask ---
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0
