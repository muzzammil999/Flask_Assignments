# Copy this file to ".env" and fill in your own values. Never share or commit ".env".
# generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-text
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=claims_db
# Set to production on a real server (secure cookies, HSTS, strict SECRET_KEY check)
APP_ENV=development
SESSION_IDLE_MINUTES=30
